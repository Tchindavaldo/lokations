<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="30dp"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/item2Ligne1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"


        android:layout_marginLeft="7dp"
        android:paddingLeft="7dp"
        android:paddingRight="7dp"
>

        <androidx.cardview.widget.CardView
            android:id="@+id/carditem2Ligne1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"


            app:cardCornerRadius="10dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView

                android:id="@+id/ImageItemLigne1"

                android:layout_width="130dp"
                android:layout_height="100dp"
                android:scaleType="centerCrop"
                android:src="@drawable/m88"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            </ImageView>

        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/text1item2Ligne1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="1dp"
            android:text="Chambre, Ngousso"
            android:textColor="@color/black"
            android:textSize="10sp"
            android:textStyle="bold"

            app:layout_constraintBottom_toTopOf="@id/text2item2Ligne1"
            app:layout_constraintLeft_toLeftOf="@id/carditem2Ligne1"
            app:layout_constraintTop_toBottomOf="@id/carditem2Ligne1" />

        <TextView
            android:id="@+id/text2item2Ligne1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="70 000/mois"
            android:textColor="@color/black_70"
            android:textSize="9sp"
            app:circularflow_radiusInDP="30dp"



            app:layout_constraintLeft_toLeftOf="@id/carditem2Ligne1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text1item2Ligne1" />


        <ImageView
            android:id="@+id/favItem2lign1"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/fv"

            android:visibility="invisible"
            app:layout_constraintRight_toLeftOf="@id/fav2Item2lign1"
            app:layout_constraintTop_toBottomOf="@id/carditem2Ligne1" />

        <ImageView
            android:id="@+id/fav2Item2lign1"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/fv"

            android:visibility="invisible"
            app:layout_constraintRight_toLeftOf="@id/fav3Item2lign1"
            app:layout_constraintTop_toBottomOf="@id/carditem2Ligne1" />

        <ImageView
            android:id="@+id/fav3Item2lign1"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:src="@drawable/fv"

            android:visibility="invisible"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text1item2Ligne1"/>


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>