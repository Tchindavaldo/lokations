<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DetailCiteActivity3">





    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dtv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="2dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >

            <ImageView
                android:id="@+id/imgBackgrounChambre"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/m6"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">


            </ImageView>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"



                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:background="#25121F">






            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/container_general_carview"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintHeight_percent="0.83"
                app:cardBackgroundColor="#00000000"
                app:cardCornerRadius="45dp"
                android:layout_marginTop="-52dp"

                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginBottom="200dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:id="@+id/conainer_Img_detail"





                    android:clipChildren="true"
                    android:layout_marginTop="52dp"


                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">



                    <androidx.cardview.widget.CardView

                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:cardBackgroundColor="#000000"
                        app:cardCornerRadius="45dp"


                        android:layout_marginTop="-52dp"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <ImageView
                            android:id="@+id/imgchambre"
                            android:visibility="visible"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginTop="52dp"

                            android:scaleType="centerCrop"
                            android:src="@drawable/m6" />

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/detail_photo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="visible"
                            android:layout_marginTop="52dp">




                            <TextView
                                android:id="@+id/lieux"
                                android:layout_width="120dp"
                                android:layout_height="35dp"
                                android:background="@drawable/background_on_image"
                                android:textColor="@color/white"

                                android:layout_marginTop="4dp"

                                android:elevation="10dp"
                                app:layout_constraintTop_toBottomOf="@id/categorie"
                                app:layout_constraintLeft_toLeftOf="@id/categorie"/>



                        </androidx.constraintlayout.widget.ConstraintLayout>




                    </androidx.cardview.widget.CardView>











                </androidx.constraintlayout.widget.ConstraintLayout>



            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:id="@+id/item3_item2_page_boutique"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"


                app:layout_constraintRight_toRightOf="@id/label_prix"
                app:layout_constraintBottom_toBottomOf="@id/categorie">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/round_white_50" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginLeft="5dp"
                    android:background="@drawable/round_white_50" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginLeft="5dp"
                    android:background="@drawable/round_white" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginLeft="5dp"
                    android:background="@drawable/round_white_50" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="8dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="5dp"
                    android:background="@drawable/round_white_50" />
            </LinearLayout>

            <TextView
                android:id="@+id/categorie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentBottom="true"
                android:layout_marginTop="4dp"
                android:layout_marginLeft="15dp"

                android:text="cité hypocrate"
                android:textColor="#E6FFFFFF"

                android:textSize="25sp"
                android:textStyle="bold"


                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/container_general_carview" />
            <TextView
                android:id="@+id/Itemcategorie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/background_on_image"
                android:textColor="#BF8383"
                android:text="Chambre1"
                android:textSize="17sp"
                android:textStyle="bold"



                android:layout_marginBottom="4dp"

                android:elevation="10dp"
                app:layout_constraintTop_toBottomOf="@id/categorie"
                app:layout_constraintBottom_toTopOf="@id/emplacement"
                app:layout_constraintLeft_toLeftOf="@id/categorie"/>
            <TextView
                android:id="@+id/label_Itemcategorie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/background_on_image"
                android:textColor="#80FFFFFF"
                android:text="Atuellement Disponible"
                android:textSize="15sp"
                android:textStyle="bold"

                android:layout_marginLeft="5dp"
                android:layout_marginBottom="4dp"

                android:elevation="10dp"
                app:layout_constraintTop_toTopOf="@id/Itemcategorie"
                app:layout_constraintLeft_toRightOf="@id/Itemcategorie"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/emplacement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="@id/Itemcategorie"
                app:layout_constraintTop_toBottomOf="@id/Itemcategorie"
                app:layout_constraintBottom_toTopOf="@id/prix">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/card2iLigne5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginLeft="15dp"

                    app:layout_constraintLeft_toRightOf="@id/textLigne5"
                    app:layout_constraintTop_toTopOf="@id/textLigne5"
                    app:layout_constraintBottom_toBottomOf="@id/textLigne5">

                    <ImageView
                        android:id="@+id/img2Ligne5"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/plce"/>

                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:id="@+id/text2Ligne5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"



                    android:layout_marginLeft="3dp"
                    android:text="Yaoundé, Cité Verte"
                    android:textColor="#CCFFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"


                    app:layout_constraintLeft_toRightOf="@id/card2iLigne5"
                    app:layout_constraintTop_toTopOf="@id/textLigne5"
                    app:layout_constraintBottom_toBottomOf="@id/textLigne5"/>
            </androidx.constraintlayout.widget.ConstraintLayout>


            <LinearLayout
                android:id="@+id/autreCité"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginBottom="5dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"

                android:gravity="center"
                android:elevation="100dp"
                android:background="@drawable/round_black_50"


                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintBottom_toBottomOf="@id/container_general_carview"


                >


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/button_detail_infos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    app:cardCornerRadius="20dp"

                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toLeftOf="@id/button_detail_photo">

                    <ImageView
                        android:id="@+id/autreCité1"
                        android:layout_width="17dp"
                        android:layout_height="17dp"

                        android:scaleType="centerCrop"
                        android:src="@drawable/pps"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                    </ImageView>

                </androidx.constraintlayout.widget.ConstraintLayout>



                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/button_detail_photo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:background="@drawable/round3"
                    android:layout_marginLeft="10dp"
                    android:padding="7dp"

                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/button_detail_infos"
                    app:layout_constraintRight_toLeftOf="@id/button_detail_comment"
                    >


                    <ImageView

                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/photo">

                    </ImageView>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/button_detail_comment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    app:cardCornerRadius="18dp"
                    android:layout_marginLeft="10dp"


                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/button_detail_photo"
                    app:layout_constraintRight_toLeftOf="@id/cardAutreCité6"
                    >


                    <ImageView

                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/comment"
                        app:layout_constraintBottom_toBottomOf="parent">

                    </ImageView>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cardAutreCité6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    app:cardCornerRadius="18dp"
                    android:layout_marginLeft="10dp"


                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/button_detail_comment"
                    app:layout_constraintRight_toRightOf="parent"
                    >



                    <ImageView

                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:src="@drawable/plce"
                        android:scaleType="centerCrop"
                        app:layout_constraintBottom_toBottomOf="parent">

                    </ImageView>

                </androidx.constraintlayout.widget.ConstraintLayout>





            </LinearLayout>

            <LinearLayout
                android:id="@+id/btmrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:layout_marginLeft="10dp"
                android:gravity="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent">



                <LinearLayout
                    android:id="@+id/louer"
                    android:layout_width="80dp"
                    android:layout_height="30dp"

                    android:gravity="center"
                    android:background="@drawable/border"


                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="louer"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="#BF8383"

                        app:layout_constraintBottom_toBottomOf="parent" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="80dp"
                    android:layout_height="30dp"
                    android:id="@+id/reserver"
                    app:cardCornerRadius="15dp"
                    android:background="@drawable/border"
                    android:gravity="center"

                    android:layout_marginLeft="10dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toLeftOf="@id/louer"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="reserver"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="#B39DDB"


                        app:layout_constraintBottom_toBottomOf="parent" />

                </LinearLayout>
            </LinearLayout>


            <TextView
                android:id="@+id/prix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"



                android:gravity="center_vertical"

                android:text="235 000"
                android:textColor="#BF8383"

                android:textSize="25sp"

                android:textStyle="bold"
                android:layout_marginBottom="19dp"

                app:layout_constraintRight_toLeftOf="@id/label_prix"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <TextView
                android:id="@+id/label_prix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:elevation="10dp"
                android:text="/Ans"
                android:textColor="#FFFFFF"


                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/prix"
                app:layout_constraintRight_toRightOf="parent" />











        </androidx.constraintlayout.widget.ConstraintLayout>



    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>