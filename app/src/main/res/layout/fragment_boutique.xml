<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragment_boutique">

    <!-- TODO: Update blank fragment layout -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="0dp"

        app:cardBackgroundColor="#00000000">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">




            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FFFFFF">

                <androidx.cardview.widget.CardView
                    android:id="@+id/entete"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"

                    app:layout_constraintHeight_percent="0.34"

                    app:cardBackgroundColor="#E6E0E3"
                    app:cardCornerRadius="35dp"
                    android:layout_marginTop="-35dp"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingTop="20dp"

                        android:layout_marginTop="35dp">

                        <androidx.constraintlayout.widget.ConstraintLayout

                            android:visibility="gone"
                            android:id="@+id/top_detail"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toTopOf="@id/infos_entete_middle">


                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginLeft="15dp"

                                app:layout_constraintLeft_toLeftOf="parent">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"

                                    android:text="Foyer De L'execllence"
                                    android:textSize="14sp"
                                    android:textColor="@color/white"

                                    android:layout_marginTop="3dp"
                                    android:layout_marginBottom="5dp"
                                    android:paddingLeft="12dp"
                                    android:paddingRight="12dp"
                                    android:background="@drawable/round_item_top1_bar_statistique_page"

                                    android:gravity="center_vertical"
                                    />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"

                                    android:text="Chambre 1"
                                    android:textSize="14sp"
                                    android:textColor="#80FFFFFF"

                                    android:layout_marginTop="3dp"
                                    android:layout_marginBottom="3dp"
                                    android:paddingLeft="12dp"
                                    android:paddingRight="12dp"

                                    android:gravity="center_vertical"
                                    />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="right"
                                android:layout_marginRight="15dp"
                                app:layout_constraintRight_toRightOf="parent">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"

                                    android:text="2024"
                                    android:textSize="12sp"
                                    android:textColor="@color/white"
                                    android:textStyle="bold"

                                    android:layout_marginRight="15dp"
                                    android:layout_marginTop="3dp"
                                    android:layout_marginBottom="3dp"
                                    android:paddingLeft="12dp"
                                    android:paddingRight="12dp"

                                    android:gravity="center_vertical"
                                    />
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:gravity="center_vertical">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"

                                        android:src="@drawable/ic_baseline_more_horiz_24"



                                        android:layout_gravity="center_vertical"
                                        />
                                </LinearLayout>

                            </LinearLayout>


                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/infos_entete_middle"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"

                            app:layout_constraintHeight_percent="0.39"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toTopOf="@id/infos_entete_botom">


                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:layout_marginLeft="25dp"
                                app:layout_constraintLeft_toLeftOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent">
                                <TextView
                                    android:id="@+id/label_montant_solde"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"

                                    android:gravity="center_vertical"



                                    android:text="Montant Du Solde"

                                    android:textColor="@color/black_50"
                                    android:textSize="15sp"


                                    />

                                <TextView
                                    android:id="@+id/montant_solde"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"



                                    android:gravity="center_vertical"

                                    android:text="10 340 000f"
                                    android:textColor="@color/black"
                                    android:textSize="30sp"

                                    android:textStyle="bold"
                                    app:layout_constraintTop_toBottomOf="@id/label_montant_solde" />

                            </androidx.constraintlayout.widget.ConstraintLayout>

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"

                                android:src="@drawable/ic_baseline_shopping_bag_24"

                                android:layout_marginRight="15dp"

                                app:layout_constraintRight_toRightOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"/>




                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/infos_entete_botom"
                            android:layout_width="0dp"
                            app:layout_constraintWidth_percent="0.7"
                            android:layout_height="0dp"

                            app:layout_constraintHeight_percent="0.25"

                            android:layout_marginLeft="25dp"
                            android:layout_marginBottom="10dp"

                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/infos_entete_middle"
                            app:layout_constraintBottom_toTopOf="@id/tabLayout">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent">

                                <LinearLayout
                                    android:id="@+id/item1_entete3"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"

                                    android:orientation="vertical"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintLeft_toLeftOf="parent">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"

                                        android:gravity="center_vertical"


                                        android:text="Revenu Mensuel"

                                        android:textColor="@color/black_50"
                                        android:textSize="10sp"


                                        />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"

                                        android:layout_marginTop="10dp"


                                        android:gravity="center_vertical"

                                        android:text="440 000f"
                                        android:textColor="@color/black"
                                        android:textSize="14sp"

                                        android:textStyle="bold" />

                                </LinearLayout>

                                <androidx.constraintlayout.widget.ConstraintLayout
                                    android:layout_width="0.8dp"
                                    android:layout_height="0dp"
                                    android:background="@color/black"

                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintHeight_percent="0.60"
                                    app:layout_constraintLeft_toRightOf="@id/item1_entete3"

                                    app:layout_constraintRight_toLeftOf="@id/item2_entete3"
                                    app:layout_constraintTop_toTopOf="parent" />

                                <LinearLayout
                                    android:id="@+id/item2_entete3"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"

                                    android:orientation="vertical"

                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintRight_toRightOf="parent">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"

                                        android:gravity="center_vertical"


                                        android:text="Revenu Mensuel"

                                        android:textColor="@color/black_50"
                                        android:textSize="10sp"


                                        />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"

                                        android:layout_marginTop="10dp"


                                        android:gravity="center_vertical"

                                        android:text="4 400 000f"
                                        android:textColor="@color/black"
                                        android:textSize="14sp"

                                        android:textStyle="bold" />

                                </LinearLayout>

                            </androidx.constraintlayout.widget.ConstraintLayout>





                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <com.google.android.material.tabs.TabLayout
                            android:id="@+id/tabLayout"
                            android:layout_width="match_parent"
                            android:layout_height="20dp"

                            android:background="#0025121F"

                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.0"
                            app:tabGravity="center"

                            app:tabIndicatorFullWidth="false"
                            app:tabMode="scrollable"
                            app:tabTextAppearance="@style/size"
                            app:tabTextColor="@color/black"
                            app:tabSelectedTextColor="@color/black"
                            app:tabIndicatorColor="@color/black"



                            android:layout_marginBottom="10dp"
                            android:layout_marginLeft="15dp"
                            android:layout_marginRight="15dp"
                            app:layout_constraintBottom_toBottomOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.cardview.widget.CardView>

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/page_boutique"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"

                        app:layout_constraintTop_toBottomOf="@id/entete"
                        app:layout_constraintBottom_toBottomOf="parent"
                        >








                    </androidx.viewpager2.widget.ViewPager2>







            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>


</FrameLayout>