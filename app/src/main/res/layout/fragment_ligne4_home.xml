<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragment_ligne4_home">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ligne4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="1dp"
        android:layout_marginTop="35dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ligne3">

        <TextView
            android:id="@+id/populaire"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"


            android:layout_marginLeft="7dp"
            android:text="populaire"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold"


            app:circularflow_radiusInDP="30dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvoir4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"


            android:layout_marginRight="3dp"
            android:text="tout voir"
            android:textColor="@color/black_50"
            android:textSize="13sp"
            android:textStyle="bold"

            app:circularflow_radiusInDP="30dp"


            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycleViewLigne4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            tools:listitem="@layout/itemligne4"
            tools:itemCount="1"

            android:layout_marginTop="25dp"

            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@id/populaire">


        </androidx.recyclerview.widget.RecyclerView>



    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>