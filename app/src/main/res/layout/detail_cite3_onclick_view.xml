<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DetailCiteActivity3">





    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dtv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="2dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >

            <ImageView
                android:id="@+id/imgBackgrounChambre"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/m6"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">


            </ImageView>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"



                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:background="#25121F">






        </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/container_general_carview"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintHeight_percent="1"
                app:cardBackgroundColor="#00000000"
                app:cardCornerRadius="45dp"
                android:layout_marginTop="-52dp"

                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginBottom="200dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:id="@+id/conainer_Img_detail"





                    android:clipChildren="true"
                    android:layout_marginTop="52dp"


                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">



                    <androidx.cardview.widget.CardView

                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:cardBackgroundColor="#000000"
                        app:cardCornerRadius="45dp"


                        android:layout_marginTop="-52dp"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <ImageView
                            android:id="@+id/imgchambre"
                            android:visibility="visible"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginTop="52dp"

                            android:scaleType="centerCrop"
                            android:src="@drawable/m6" />

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/detail_photo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="visible"
                            android:layout_marginTop="52dp">



                           <LinearLayout
                           android:layout_width="wrap_content"
                           android:layout_height="wrap_content"
                           android:orientation="vertical"

                               android:visibility="gone"
                           android:paddingRight="15dp"
                           app:layout_constraintTop_toTopOf="parent"
                           app:layout_constraintLeft_toLeftOf="parent">
                           <TextView
                               android:id="@+id/categorie"
                               android:layout_width="wrap_content"
                               android:layout_height="wrap_content"
                               android:layout_alignParentStart="true"
                               android:layout_alignParentBottom="true"

                               android:layout_marginTop="4dp"
                               android:layout_marginLeft="5dp"

                               android:paddingTop="12dp"
                               android:paddingBottom="12dp"
                               android:paddingLeft="12dp"
                               android:paddingRight="12dp"

                               android:background="@drawable/round_black_50"
                               android:text="cité hypocrate"
                               android:textColor="#FFFFFF"
                               android:textSize="18sp"
                               android:textStyle="bold"


                               app:layout_constraintStart_toStartOf="parent"
                               app:layout_constraintTop_toTopOf="parent" />

                           <androidx.constraintlayout.widget.ConstraintLayout
                               android:id="@+id/emplacement"
                               android:layout_width="wrap_content"
                               android:layout_height="wrap_content"


                               android:layout_marginStart="5dp"
                               android:layout_marginTop="5dp"


                               android:paddingTop="10dp"
                               android:paddingBottom="10dp"
                               android:paddingLeft="12dp"
                               android:paddingRight="12dp"

                               android:background="@drawable/round_black_50"

                               app:layout_constraintTop_toBottomOf="@id/categorie"
                               app:layout_constraintLeft_toLeftOf="@id/categorie">
                               <androidx.constraintlayout.widget.ConstraintLayout
                                   android:id="@+id/card2iLigne5"
                                   android:layout_width="wrap_content"
                                   android:layout_height="wrap_content"


                                   app:layout_constraintLeft_toRightOf="@id/textLigne5"
                                   app:layout_constraintTop_toTopOf="@id/textLigne5"
                                   app:layout_constraintBottom_toBottomOf="@id/textLigne5">

                                   <ImageView
                                       android:id="@+id/img2Ligne5"
                                       android:layout_width="18dp"
                                       android:layout_height="18dp"
                                       android:scaleType="centerCrop"
                                       android:src="@drawable/plce"/>

                               </androidx.constraintlayout.widget.ConstraintLayout>
                               <TextView
                                   android:id="@+id/text2Ligne5"
                                   android:layout_width="wrap_content"
                                   android:layout_height="wrap_content"

                                   android:text="Yaoundé, Cité Verte"
                                   android:textColor="#80FFFFFF"
                                   android:textSize="15sp"
                                   android:textStyle="bold"

                                   android:layout_marginTop="5dp"



                                   app:layout_constraintLeft_toRightOf="@id/card2iLigne5"
                                   app:layout_constraintTop_toTopOf="@id/textLigne5"
                                   app:layout_constraintBottom_toBottomOf="@id/textLigne5"/>
                           </androidx.constraintlayout.widget.ConstraintLayout>

                       </LinearLayout>

                           <LinearLayout
                               android:layout_width="wrap_content"
                               android:layout_height="wrap_content"
                               android:orientation="vertical"

                               app:layout_constraintTop_toTopOf="parent"
                               app:layout_constraintLeft_toLeftOf="parent">
                               <TextView
                                   android:id="@+id/Itemcategorie"
                                   android:layout_width="wrap_content"
                                   android:layout_height="wrap_content"
                                   android:background="@drawable/round_black_50"
                                   android:textColor="#FFFFFF"
                                   android:text="Chambre1"
                                   android:textSize="18sp"
                                   android:textStyle="bold"

                                   android:layout_marginLeft="5dp"
                                   android:layout_marginBottom="4dp"

                                   android:paddingTop="10dp"
                                   android:paddingBottom="10dp"
                                   android:paddingLeft="12dp"
                                   android:paddingRight="10dp"

                                />

                                   <TextView
                                       android:id="@+id/prix"
                                       android:layout_width="wrap_content"
                                       android:layout_height="wrap_content"



                                       android:gravity="center_vertical"

                                       android:text="235 000 /Ans"
                                       android:textColor="#80FFFFFF"
                                       android:textSize="15sp"
                                       android:textStyle="bold"


                                       android:layout_marginBottom="4dp"
                                       android:layout_marginLeft="5dp"

                                       android:paddingTop="10dp"
                                       android:paddingBottom="10dp"
                                       android:paddingLeft="12dp"
                                       android:paddingRight="25dp"
                                       android:background="@drawable/round_black_50"

                                       app:layout_constraintRight_toLeftOf="@id/label_prix"
                                       app:layout_constraintTop_toBottomOf="@id/label_Itemcategorie"/>


                           </LinearLayout>

                            <LinearLayout
                                android:id="@+id/item3_item2_page_boutique"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:visibility="gone"
                                android:layout_marginLeft="45dp"
                                android:layout_marginBottom="5dp"
                                app:layout_constraintLeft_toLeftOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent">

                                <androidx.constraintlayout.widget.ConstraintLayout
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@drawable/round_white_50" />

                                <androidx.constraintlayout.widget.ConstraintLayout
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:layout_marginLeft="5dp"
                                    android:background="@drawable/round_white_50" />

                                <androidx.constraintlayout.widget.ConstraintLayout
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:layout_marginLeft="5dp"
                                    android:background="@drawable/round_white" />

                                <androidx.constraintlayout.widget.ConstraintLayout
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:layout_marginLeft="5dp"
                                    android:background="@drawable/round_white_50" />

                                <androidx.constraintlayout.widget.ConstraintLayout
                                    android:layout_width="8dp"
                                    android:layout_height="match_parent"
                                    android:layout_marginLeft="5dp"
                                    android:background="@drawable/round_white_50" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/container_item_nav"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:layout_marginBottom="5dp"


                                android:paddingRight="20dp"
                                android:paddingLeft="20dp"
                                android:paddingTop="10dp"
                                android:paddingBottom="10dp"

                                android:orientation="horizontal"
                                android:gravity="center"

                                android:background="@drawable/round_nav_detail"


                                app:layout_constraintLeft_toLeftOf="parent"
                                app:layout_constraintRight_toRightOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"

                                >


                                <LinearLayout
                                    android:id="@+id/button_detail_infos"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"


                                    android:background="@drawable/round_item_nav_detail"
                                    android:gravity="center"
                                    android:padding="8dp"

                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintLeft_toLeftOf="parent"
                                    app:layout_constraintRight_toLeftOf="@id/button_detail_photo"
                                    app:layout_constraintTop_toTopOf="parent">

                                    <ImageView
                                        android:id="@+id/autreCité1"
                                        android:layout_width="13dp"
                                        android:layout_height="15dp"

                                        android:scaleType="centerCrop"
                                        android:src="@drawable/pps"
                                        >

                                    </ImageView>

                                </LinearLayout>


                                <LinearLayout
                                    android:id="@+id/button_detail_photo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"

                                    android:layout_marginLeft="15dp"
                                    android:background="@drawable/round_item_selected_nav_detail"
                                    android:gravity="center"
                                    android:padding="8dp"

                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintLeft_toRightOf="@+id/button_detail_infos"
                                    app:layout_constraintRight_toLeftOf="@id/button_detail_comment"
                                    app:layout_constraintTop_toTopOf="parent">


                                    <ImageView

                                        android:layout_width="13dp"
                                        android:layout_height="15dp"
                                        android:scaleType="centerCrop"
                                        android:src="@drawable/photo"
                                        >

                                    </ImageView>

                                </LinearLayout>


                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"

                                    android:layout_marginLeft="15dp"
                                    android:background="@drawable/round_item_nav_detail"
                                    android:gravity="center"
                                    android:padding="8dp"


                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintLeft_toRightOf="@+id/button_detail_photo"
                                    app:layout_constraintRight_toLeftOf="@id/cardAutreCité6"
                                    app:layout_constraintTop_toTopOf="parent">


                                    <ImageView

                                        android:layout_width="13dp"
                                        android:layout_height="15dp"
                                        android:scaleType="centerCrop"
                                        android:src="@drawable/comment">

                                    </ImageView>

                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"

                                    android:layout_marginLeft="15dp"
                                    android:background="@drawable/round_item_nav_detail"
                                    android:gravity="center"
                                    android:padding="8dp"


                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintLeft_toRightOf="@+id/button_detail_photo"
                                    app:layout_constraintRight_toLeftOf="@id/cardAutreCité6"
                                    app:layout_constraintTop_toTopOf="parent">


                                    <ImageView

                                        android:layout_width="13dp"
                                        android:layout_height="15dp"
                                        android:scaleType="centerCrop"
                                        android:src="@drawable/comment">

                                    </ImageView>

                                </LinearLayout>


                                <LinearLayout
                                    android:id="@+id/cardAutreCité6"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"

                                    android:layout_marginLeft="15dp"
                                    android:background="@drawable/round_item_nav_detail"
                                    android:gravity="center"
                                    android:padding="8dp"


                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintLeft_toRightOf="@+id/button_detail_comment"
                                    app:layout_constraintRight_toRightOf="parent"
                                    app:layout_constraintTop_toTopOf="parent">


                                    <ImageView

                                        android:layout_width="13dp"
                                        android:layout_height="15dp"
                                        android:scaleType="centerCrop"
                                        android:src="@drawable/plce"
                                        >

                                    </ImageView>

                                </LinearLayout>






                            </LinearLayout>




                        </androidx.constraintlayout.widget.ConstraintLayout>




                    </androidx.cardview.widget.CardView>











                </androidx.constraintlayout.widget.ConstraintLayout>



            </androidx.cardview.widget.CardView>


















        </androidx.constraintlayout.widget.ConstraintLayout>



</androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>