<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    >

    <LinearLayout


        android:orientation="vertical"
        android:id="@+id/L"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="10dp"
>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/text1Linge1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/black_50"
        android:text="top qualité"
        android:textSize="13sp"
        android:layout_weight="1"/>
    <TextView
        android:id="@+id/text2Linge1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="tout voir"
        android:textColor="@color/black_50"
        android:gravity="right"
        android:textSize="10sp"
        android:layout_weight="0.1"/>

</LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv2"


            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:background="#08000000"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:itemCount="3"
            tools:listitem="@layout/icon4">


        </androidx.recyclerview.widget.RecyclerView>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/text1Linge2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/black_50"
                android:text="top qualité"
                android:textSize="13sp"
                android:layout_weight="1"/>
            <TextView
                android:id="@+id/text2Linge2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="tout voir"
                android:textColor="@color/black_50"
                android:gravity="right"
                android:textSize="10sp"
                android:layout_weight="0.1"/>

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv3"


            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rv2"
            android:background="#08000000"
            tools:itemCount="3"
            tools:listitem="@layout/icon5">


        </androidx.recyclerview.widget.RecyclerView>


    </LinearLayout>

</LinearLayout>