<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/item1Ligne3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"


        android:layout_marginLeft="7dp"
        android:layout_marginTop="25dp"
        android:background="@drawable/round5"
        android:paddingRight="7dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/card1Item1Ligne3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            app:cardCornerRadius="13dp"


            app:layout_constraintLeft_toLeftOf="parent">


            <ImageView

                android:layout_width="130dp"
                android:layout_height="130dp"
                android:scaleType="centerCrop"
                android:src="@drawable/m4"
                app:layout_constraintBottom_toBottomOf="parent">

            </ImageView>

        </androidx.cardview.widget.CardView>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/card2item1Ligne3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="2dp"

            app:layout_constraintBottom_toTopOf="@id/text3item1Ligne3"
            app:layout_constraintLeft_toRightOf="@id/card1Item1Ligne3"
            app:layout_constraintTop_toTopOf="@id/card1Item1Ligne3">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/plce" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/text4item1Ligne3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="bonandjo"
            android:textColor="#B3FFFFFF"
            android:textSize="10sp"
            app:circularflow_radiusInDP="30dp"


            app:layout_constraintBottom_toBottomOf="@id/card2item1Ligne3"
            app:layout_constraintLeft_toRightOf="@id/card2item1Ligne3" />

        <TextView
            android:id="@+id/text3item1Ligne3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginLeft="5dp"
            android:layout_marginBottom="3dp"
            android:text="cité rose"
            android:textColor="#B3FFFFFF"

            android:textSize="10sp"
            app:circularflow_radiusInDP="30dp"


            app:layout_constraintBottom_toTopOf="@id/text2item1Ligne3"
            app:layout_constraintLeft_toRightOf="@id/card1Item1Ligne3"
            app:layout_constraintTop_toBottomOf="@id/text4item1Ligne3" />

        <TextView
            android:id="@+id/text2item1Ligne3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginLeft="5dp"
            android:layout_marginBottom="3dp"
            android:text="Chambre N°4"
            android:textColor="#B3FFFFFF"


            android:textSize="10sp"
            app:circularflow_radiusInDP="30dp"


            app:layout_constraintBottom_toTopOf="@id/text1item1Ligne3"
            app:layout_constraintLeft_toRightOf="@id/card1Item1Ligne3"
            app:layout_constraintTop_toBottomOf="@id/text3item1Ligne3" />

        <TextView
            android:id="@+id/text1item1Ligne3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginLeft="5dp"
            android:text="300 000/ans"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"

            app:circularflow_radiusInDP="30dp"

            app:layout_constraintBottom_toBottomOf="@id/card1Item1Ligne3"
            app:layout_constraintLeft_toRightOf="@id/card1Item1Ligne3"
            app:layout_constraintTop_toBottomOf="@id/text2item1Ligne3" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>