<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="7dp"
    android:paddingRight="7dp"
    >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"

            >

            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0.9"


                android:layout_alignParentLeft="true"
                android:text="En cours de construction"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0.1"
                android:gravity="center_vertical|right"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"


                    android:text="Notification"
                    android:textColor="@color/black_50"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginRight="3dp"/>
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_baseline_notifications_none_24"/>
            </LinearLayout>

        </LinearLayout>

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/viewPager"

            android:layout_width="match_parent"
            android:layout_height="175dp"
            android:layout_marginTop="15dp"



            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">

        </androidx.viewpager.widget.ViewPager>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:paddingLeft="1dp"
            android:paddingRight="1dp"
            android:gravity="left">
            <LinearLayout

                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.9"

                android:gravity="center_vertical"

                >

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_marginLeft="5dp"
                    android:background="@drawable/round_black_50_50" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_marginLeft="5dp"
                    android:background="@drawable/round_black_50" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_marginLeft="5dp"
                    android:background="@drawable/round_black_50_50" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_marginLeft="5dp"
                    android:background="@drawable/round_black_50_50" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="0.1"
                android:gravity="center_vertical|right">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/carditem2Ligne4">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:gravity="center_vertical"

                        app:layout_constraintLeft_toLeftOf="parent">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="300"

                            android:textColor="@color/black_50"
                            android:textSize="9sp" />
                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:layout_marginLeft="3dp"
                            android:src="@drawable/ic_baseline_thumb_up_off_alt_24"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:gravity="center_vertical"
                        android:layout_marginLeft="8dp"

                        >

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="50"

                            android:textColor="@color/black_50"
                            android:textSize="9sp"/>
                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:layout_marginLeft="3dp"
                            android:src="@drawable/ic_baseline_thumb_down_off_alt_24"/>
                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:gravity="center"
                    android:layout_marginLeft="3dp"
                    android:layout_marginRight="3dp"
                    android:background="@drawable/round_black_50">

                    <ImageView
                        android:layout_width="6dp"
                        android:layout_height="10dp"
                        android:src="@drawable/fv" />
                </LinearLayout>

                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="4.5"
                    android:textColor="@color/black"
                    android:layout_marginRight="5dp"

                    android:textSize="10sp"
                    app:circularflow_radiusInDP="30dp"
                    />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/card2item2Ligne4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginRight="5dp"


                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/carditem2Ligne4">

                    <ImageView
                        android:id="@+id/Img2ItemLigne4"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:src="@drawable/favoris" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:background="@drawable/round_black_10"
                    android:padding="4dp"

                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="reserver"

                    android:textColor="@color/white"


                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
