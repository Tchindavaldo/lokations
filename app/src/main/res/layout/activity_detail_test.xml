<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".detail_test">

    <androidx.cardview.widget.CardView
        android:id="@+id/detail_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="#000000"
        app:cardCornerRadius="45dp"
        android:visibility="visible"

        android:layout_marginTop="-52dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="52dp">

            <ImageView
                android:id="@+id/imgchambre"
                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:background="@drawable/roundx"
                android:scaleType="centerCrop"
                android:src="@drawable/m6" />

            <TextView
                android:id="@+id/categorie"
                android:layout_width="170dp"
                android:layout_height="35dp"
                android:background="@drawable/background_on_image"
                android:textColor="@color/white"


                android:layout_marginLeft="4dp"
                android:layout_marginTop="4dp"


                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"/>

            <TextView
                android:id="@+id/lieux"
                android:layout_width="120dp"
                android:layout_height="35dp"
                android:background="@drawable/background_on_image"
                android:textColor="@color/white"

                android:layout_marginTop="4dp"

                android:elevation="10dp"
                app:layout_constraintTop_toBottomOf="@id/categorie"
                app:layout_constraintLeft_toLeftOf="@id/categorie"/>

            <TextView
                android:id="@+id/Itemcategorie"
                android:layout_width="120dp"
                android:layout_height="35dp"
                android:background="@drawable/background_on_image"
                android:textColor="@color/white"



                android:layout_marginBottom="4dp"

                android:elevation="10dp"
                app:layout_constraintBottom_toTopOf="@id/prix"
                app:layout_constraintLeft_toLeftOf="@id/prix"/>

            <TextView
                android:id="@+id/prix"
                android:layout_width="170dp"
                android:layout_height="35dp"
                android:background="@drawable/background_on_image"
                android:textColor="@color/white"

                android:layout_marginLeft="4dp"
                android:layout_marginBottom="4dp"

                android:elevation="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>




    </androidx.cardview.widget.CardView>


</androidx.constraintlayout.widget.ConstraintLayout>