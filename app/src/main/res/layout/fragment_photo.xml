<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/fragment_photo2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragment_photo">

    <!-- TODO: Update blank fragment layout -->
    <androidx.cardview.widget.CardView

        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="#000000"

        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        </androidx.viewpager.widget.ViewPager>


    </androidx.cardview.widget.CardView>
    <LinearLayout
        android:id="@+id/top_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"

        android:elevation="5dp"
        android:paddingRight="15dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent">
        <TextView
            android:id="@+id/categorie"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"

            android:layout_marginTop="4dp"
            android:layout_marginLeft="5dp"

            android:paddingTop="5dp"
            android:paddingBottom="6dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"

            android:background="@drawable/round_black"
            android:text="cité hypocrate"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"


            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/emplacement"
            android:layout_width="175dp"
            android:layout_height="wrap_content"


            android:layout_marginStart="5dp"
            android:layout_marginTop="5dp"


            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"

            android:background="@drawable/round_black"

            app:layout_constraintTop_toBottomOf="@id/categorie"
            app:layout_constraintLeft_toLeftOf="@id/categorie">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card2iLigne5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"


                app:layout_constraintLeft_toRightOf="@id/textLigne5"
                app:layout_constraintTop_toTopOf="@id/textLigne5"
                app:layout_constraintBottom_toBottomOf="@id/textLigne5">

                <ImageView
                    android:id="@+id/img2Ligne5"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/plce"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:id="@+id/lieux"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Yaoundé, Cité Verte"
                android:textColor="#80FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"

                android:layout_marginTop="5dp"



                app:layout_constraintLeft_toRightOf="@id/card2iLigne5"
                app:layout_constraintTop_toTopOf="@id/textLigne5"
                app:layout_constraintBottom_toBottomOf="@id/textLigne5"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"

        android:layout_marginBottom="35dp"

        android:elevation="5dp"
        android:layout_gravity="bottom"
        app:layout_constraintBottom_toTopOf="@id/item3_item2_page_boutique"
        app:layout_constraintLeft_toLeftOf="parent">
        <TextView
            android:id="@+id/Itemcategorie"
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:background="@drawable/round_black"
            android:textColor="#FFFFFF"
            android:text="Chambre1"
            android:textSize="18sp"
            android:textStyle="bold"

            android:layout_marginLeft="5dp"
            android:layout_marginBottom="4dp"

            android:paddingTop="4dp"
            android:paddingBottom="5dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"

            />

        <TextView
            android:id="@+id/prix"
            android:layout_width="120dp"
            android:layout_height="wrap_content"



            android:gravity="center_vertical"

            android:text="235 000 /Ans"
            android:textColor="#80FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"


            android:layout_marginBottom="4dp"
            android:layout_marginLeft="5dp"

            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:paddingLeft="12dp"
            android:paddingRight="16dp"
            android:background="@drawable/round_black"

            app:layout_constraintRight_toLeftOf="@id/label_prix"
            app:layout_constraintTop_toBottomOf="@id/label_Itemcategorie"/>


        <TextView
            android:id="@+id/label_Itemcategorie"
            android:layout_width="wrap_content"
            android:layout_height="25dp"
            android:background="@drawable/round_black"
            android:textColor="#80FFFFFF"
            android:text="Atuellement Disponible"
            android:textSize="15sp"
            android:textStyle="bold"

            android:layout_marginLeft="5dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"


            android:elevation="10dp"
            app:layout_constraintTop_toTopOf="@id/Itemcategorie"
            app:layout_constraintRight_toRightOf="parent"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/item3_item2_page_boutique"
        android:layout_width="81dp"
        android:layout_height="10dp"

        android:layout_gravity="bottom"
        android:layout_marginLeft="5dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/round_black_70_25"

        android:elevation="25dp"
        android:paddingLeft="12dp"
        android:paddingTop="4dp"
        android:paddingRight="12dp"
        android:paddingBottom="5dp">

        <me.relex.circleindicator.CircleIndicator
            android:id="@+id/indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="10dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintBottom_toTopOf="@id/viewPager"/>

         </LinearLayout>



</FrameLayout>