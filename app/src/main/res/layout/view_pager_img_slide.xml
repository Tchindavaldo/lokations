<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_item_0"
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:layout_gravity="center_horizontal"

        app:cardCornerRadius="15dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <ImageView
            android:id="@+id/img1Homee"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/m91" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#B3000000"
            android:layout_gravity="bottom"
            android:paddingBottom="1dp">


            <androidx.cardview.widget.CardView
                android:id="@+id/card2item2Ligne2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginLeft="20dp"
                android:layout_marginTop="5dp"
                app:cardCornerRadius="25dp"
                >

                <ImageView
                    android:id="@+id/img2item2Ligne2"
                    android:layout_width="35dp"
                    android:layout_height="35dp"

                    android:scaleType="centerCrop"
                    android:src="@drawable/m88"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                </ImageView>

            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:layout_marginLeft="15dp">
                <TextView
                    android:id="@+id/statut"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"


                    android:text="Cité niva"
                    android:textColor="#E6FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"


                    app:circularflow_radiusInDP="30dp"
                    app:layout_constraintBottom_toTopOf="@id/prix"
                    app:layout_constraintLeft_toRightOf="@id/card2item2Ligne2"
                    app:layout_constraintTop_toTopOf="@id/card2item2Ligne2" />

                <TextView
                    android:id="@+id/prix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="1 chambre en cour de l'iberartion, 3 chambre disponible"
                    android:textColor="#B3FFFFFF"
                    android:textSize="10sp"
                    app:circularflow_radiusInDP="30dp"


                    app:layout_constraintBottom_toBottomOf="@id/card2item2Ligne2"
                    app:layout_constraintLeft_toLeftOf="@id/statut" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>


</androidx.constraintlayout.widget.ConstraintLayout>