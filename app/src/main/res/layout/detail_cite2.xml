<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CD25121F"
    tools:context=".DetailCiteActivity2"
    tools:ignore="MissingClass">





    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dtv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="2dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/cardimgchambre">

            <androidx.cardview.widget.CardView

                android:layout_width="match_parent"
                android:layout_height="330dp"

                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                app:cardCornerRadius="18dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">


                <ImageView
                    android:id="@+id/imgchambre"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/m6"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">


                </ImageView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"


                    android:layout_marginTop="5dp"
                    app:cardCornerRadius="15dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#DE25121F"
                        android:padding="9dp"
                        android:text="next"
                        android:textColor="@color/white"

                        app:layout_constraintBottom_toBottomOf="parent" />



                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="70dp"
                    >


                </androidx.cardview.widget.CardView>


            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/nnchmbre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="9dp"
                android:layout_marginBottom="5dp"


                android:layout_marginTop="5dp"
                app:cardCornerRadius="15dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#C8020101"
                    android:padding="5dp"
                    android:text="chmbre 2"
                    android:textColor="@color/white"

                    app:layout_constraintBottom_toBottomOf="parent" />



            </androidx.cardview.widget.CardView>



        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/nncite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="9dp"
            android:layout_marginTop="9dp"

            android:text="cité  hypocrate"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="18sp"

            android:textStyle="bold"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardimgchambre" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/iconimg"
            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:layout_marginTop="9dp"
            android:layout_marginRight="9dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardimgchambre">


            <ImageView
                android:id="@+id/comment"
                android:layout_width="10dp"
                android:layout_height="20dp"
                android:layout_marginLeft="10dp"
                android:src="@drawable/comment"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            </ImageView>

            <ImageView
                android:id="@+id/like"
                android:layout_width="10dp"
                android:layout_height="20dp"
                android:layout_marginLeft="20dp"
                android:src="@drawable/like"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/comment"
                app:layout_constraintRight_toLeftOf="@+id/disLike"
                app:layout_constraintTop_toTopOf="parent">

            </ImageView>

            <ImageView
                android:id="@+id/disLike"
                android:layout_width="10dp"
                android:layout_height="20dp"
                android:layout_marginLeft="20dp"
                android:src="@drawable/klity"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/like"
                app:layout_constraintTop_toTopOf="parent">

            </ImageView>

            <ImageView
                android:id="@+id/fav"
                android:layout_width="10dp"
                android:layout_height="20dp"
                android:layout_marginLeft="20dp"
                android:src="@drawable/fv"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/disLike">

            </ImageView>





        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/detail1"
            android:layout_width="330dp"
            android:layout_height="match_parent"



            android:layout_marginTop="35dp"

            android:paddingTop="5dp"


            android:paddingBottom="20dp"
            app:cardCornerRadius="0dp"
            app:layout_constraintBottom_toTopOf="@id/nAutrecité"
            app:layout_constraintLeft_toLeftOf="parent"

            app:layout_constraintTop_toBottomOf="@+id/iconimg"

            >

            <androidx.cardview.widget.CardView
                android:id="@+id/cardInterieur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginLeft="10dp"
                android:layout_marginTop="0dp"

                app:cardCornerRadius="13dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent">


                <TextView
                    android:id="@+id/interieur"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#CD25121F"
                    android:paddingLeft="5dp"


                    android:paddingTop="5dp"
                    android:paddingRight="5dp"
                    android:text="INTERIEUR"

                    android:textAllCaps="true"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:circularflow_radiusInDP="30dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.cardview.widget.CardView>


            <TextView
                android:id="@+id/doucheInt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"

                android:paddingLeft="10dp"

                android:paddingRight="5dp"
                android:text="dimensioné de 5m de longueur et 10m de largeur et 3m de hauteur elle est equipé d'une douche interne d'un placard et d'un coin cuisine le solest coreler les murs paint de couleur blnche et le haut plafond en tres bonne etat"


                android:textAlignment="viewStart"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cardInterieur" />


        </androidx.constraintlayout.widget.ConstraintLayout>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/nAutrecité"


            android:text="Autre cité"
            android:textAllCaps="true"

            android:textColor="#CCFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"

            android:layout_marginTop="15dp"
            android:layout_marginLeft="10dp"

            app:layout_constraintTop_toBottomOf="@id/detail1"
            app:layout_constraintLeft_toLeftOf="@id/detail1">


        </TextView>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/autreCité"
            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:layout_marginTop="9dp"
            android:layout_marginRight="9dp"

            app:layout_constraintLeft_toLeftOf="@id/nAutrecité"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/nAutrecité">


            <androidx.cardview.widget.CardView
                android:id="@+id/cardAutreCité1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                app:cardCornerRadius="20dp"

                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/autreCité1"
                    android:layout_width="65dp"
                    android:layout_height="60dp"

                    android:src="@drawable/m7"
                    android:scaleType="centerCrop"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                </ImageView>

            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/cardAutreCité2"


                app:cardCornerRadius="18dp"
                android:layout_marginLeft="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/cardAutreCité1"
                app:layout_constraintRight_toLeftOf="@+id/cardAutreCité3"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView

                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/m4"
                    android:scaleType="centerCrop"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                </ImageView>

            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView

                android:id="@+id/cardAutreCité3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                app:cardCornerRadius="18dp"
                android:layout_marginLeft="10dp"

                app:layout_constraintLeft_toRightOf="@+id/cardAutreCité2"
                app:layout_constraintRight_toLeftOf="@id/cardAutreCité4">


                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/m2"
                    android:scaleType="centerCrop"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                </ImageView>


            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardAutreCité4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                app:cardCornerRadius="18dp"
                android:layout_marginLeft="10dp"


                app:layout_constraintLeft_toRightOf="@+id/cardAutreCité3"
                >



                <ImageView

                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/m5"
                    android:scaleType="centerCrop"
                    app:layout_constraintBottom_toBottomOf="parent">

                </ImageView>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardAutreCité5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                app:cardCornerRadius="18dp"
                android:layout_marginLeft="10dp"


                app:layout_constraintLeft_toRightOf="@+id/cardAutreCité4"
                >



                <ImageView

                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/m3"
                    android:scaleType="centerCrop"
                    app:layout_constraintBottom_toBottomOf="parent">

                </ImageView>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardAutreCité6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                app:cardCornerRadius="18dp"
                android:layout_marginLeft="10dp"


                app:layout_constraintLeft_toRightOf="@+id/cardAutreCité5"
                >



                <ImageView

                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/m1"
                    android:scaleType="centerCrop"
                    app:layout_constraintBottom_toBottomOf="parent">

                </ImageView>

            </androidx.cardview.widget.CardView>





        </androidx.constraintlayout.widget.ConstraintLayout>





    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btmrl"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent">



            <TextView
                android:id="@+id/prixchambre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="25dp"



                android:text="300 000/ans"
                android:textColor="#B3FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:circularflow_radiusInDP="30dp"
                app:layout_constraintBottom_toBottomOf="@id/reserver"
                app:layout_constraintLeft_toLeftOf="parent"/>






        <androidx.cardview.widget.CardView
            android:id="@+id/louer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="15dp"

            android:layout_marginRight="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#DE25121F"
                android:padding="15dp"
                android:text="louer"
                android:textColor="@color/white"

                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/reserver"
            android:layout_marginRight="10dp"
            app:cardCornerRadius="15dp"

            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toLeftOf="@id/louer"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#25121F"
                android:padding="15dp"
                android:text="reserver"
                android:textColor="@color/white"

                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>