<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">





    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dtv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="2dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >

            <ImageView
                android:id="@+id/imgBackgrounChambre"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/m6"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">


            </ImageView>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"



                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:background="#A6000000">






        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/cardimgchambre"


            android:background="@drawable/roundx"


            android:clipChildren="true"

            android:layout_marginBottom="52dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardBackgroundColor="#000000"
                app:cardCornerRadius="45dp"

                android:layout_marginTop="-52dp"
                app:layout_constraintBottom_toBottomOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="52dp">

                    <ImageView
                        android:id="@+id/imgchambre"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"

                        android:background="@drawable/roundx"
                        android:scaleType="centerCrop"
                        android:src="@drawable/m6" />

                    <TextView
                        android:id="@+id/categorie"
                        android:layout_width="170dp"
                        android:layout_height="35dp"
                        android:background="@drawable/background_on_image"
                        android:textColor="@color/white"


                        android:layout_marginLeft="4dp"
                        android:layout_marginTop="4dp"


                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"/>

                    <TextView
                        android:id="@+id/lieux"
                        android:layout_width="120dp"
                        android:layout_height="35dp"
                        android:background="@drawable/background_on_image"
                        android:textColor="@color/white"

                        android:layout_marginTop="4dp"

                        android:elevation="10dp"
                        app:layout_constraintTop_toBottomOf="@id/categorie"
                        app:layout_constraintLeft_toLeftOf="@id/categorie"/>

                    <TextView
                        android:id="@+id/Itemcategorie"
                        android:layout_width="120dp"
                        android:layout_height="35dp"
                        android:background="@drawable/background_on_image"
                        android:textColor="@color/white"



                        android:layout_marginBottom="4dp"

                        android:elevation="10dp"
                        app:layout_constraintBottom_toTopOf="@id/prix"
                        app:layout_constraintLeft_toLeftOf="@id/prix"/>

                    <TextView
                        android:id="@+id/prix"
                        android:layout_width="170dp"
                        android:layout_height="35dp"
                        android:background="@drawable/background_on_image"
                        android:textColor="@color/white"

                        android:layout_marginLeft="4dp"
                        android:layout_marginBottom="4dp"

                        android:elevation="10dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>




            </androidx.cardview.widget.CardView>





        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/autreCité"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"


                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardimgchambre">


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cardAutreCité1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    app:cardCornerRadius="20dp"

                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toLeftOf="@id/cardAutreCité3">

                    <ImageView
                        android:id="@+id/autreCité1"
                        android:layout_width="23dp"
                        android:layout_height="23dp"

                        android:scaleType="centerCrop"
                        android:src="@drawable/pps"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                    </ImageView>

                </androidx.constraintlayout.widget.ConstraintLayout>




                <androidx.cardview.widget.CardView

                    android:id="@+id/cardAutreCité3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    app:cardCornerRadius="18dp"


                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/cardAutreCité1"
                    app:layout_constraintRight_toLeftOf="@id/cardAutreCité4">


                    <ImageView
                        android:layout_width="23dp"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/prix"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                    </ImageView>


                </androidx.cardview.widget.CardView>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cardAutreCité4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:background="@drawable/round3"
                    app:cardCornerRadius="18dp"

                    android:padding="10dp"

                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/cardAutreCité3"
                    app:layout_constraintRight_toLeftOf="@id/cardAutreCité5"
                    >



                    <ImageView

                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:src="@drawable/photo"
                        android:scaleType="centerCrop"
                        app:layout_constraintBottom_toBottomOf="parent">

                    </ImageView>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cardAutreCité5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    app:cardCornerRadius="18dp"



                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/cardAutreCité4"
                    app:layout_constraintRight_toLeftOf="@id/cardAutreCité6"
                    >


                    <ImageView

                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/comment"
                        app:layout_constraintBottom_toBottomOf="parent">

                    </ImageView>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cardAutreCité6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    app:cardCornerRadius="18dp"



                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/cardAutreCité5"
                    app:layout_constraintRight_toRightOf="parent"
                    >



                    <ImageView

                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:src="@drawable/plce"
                        android:scaleType="centerCrop"
                        app:layout_constraintBottom_toBottomOf="parent">

                    </ImageView>

                </androidx.constraintlayout.widget.ConstraintLayout>





            </androidx.constraintlayout.widget.ConstraintLayout>









    </androidx.constraintlayout.widget.ConstraintLayout>



</androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>