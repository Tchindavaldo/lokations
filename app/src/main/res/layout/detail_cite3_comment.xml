<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC25121F">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dtv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="2dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/imgBackgrounChambre"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/m6"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">


            </ImageView>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"


                android:background="#25121F"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">


            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardimgchambre"
                android:layout_width="match_parent"
                android:layout_height="match_parent"


                android:layout_marginBottom="52dp"
                android:elevation="5dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent">



                <androidx.cardview.widget.CardView

                    android:id="@+id/cardView"
                    android:layout_width="match_parent"


                    android:layout_height="match_parent"

                    app:cardCornerRadius="45dp"
                    android:layout_marginTop="-52dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintCircleRadius="70dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">


                    <ImageView
                        android:id="@+id/imgchambre"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/m6"

                        android:layout_marginTop="52dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">


                    </ImageView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:cardBackgroundColor="#80000000"/>



                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    app:cardBackgroundColor="#00000000"
                    app:cardCornerRadius="0dp"



                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">


                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"


                        android:background="#00000000"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_bias="0.493"
                        tools:layout_editor_absoluteX="0dp">

                        <TextView
                            android:id="@+id/negatif"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="40dp"

                            android:text="Negatif"

                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold"

                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintRight_toLeftOf="@id/positif"
                            app:layout_constraintTop_toTopOf="parent" />

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="50dp"
                            android:layout_height="1dp"

                            android:layout_marginTop="5dp"
                            android:background="@color/white"
                            app:layout_constraintLeft_toLeftOf="@id/negatif"
                            app:layout_constraintRight_toRightOf="@id/negatif"
                            app:layout_constraintTop_toBottomOf="@id/negatif" />

                        <TextView
                            android:id="@+id/positif"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="Positif"
                            android:textColor="#B3FFFFFF"
                            android:textSize="16sp"

                            app:layout_constraintBottom_toBottomOf="@+id/negatif"
                            app:layout_constraintLeft_toRightOf="@id/negatif"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintTop_toTopOf="@id/negatif" />
                        
                        <LinearLayout
                            android:id="@+id/conatinerComment1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            
                            android:layout_marginTop="50dp"
                            app:layout_constraintTop_toBottomOf="@id/negatif">
                            
                            <ImageView
                                android:layout_width="45dp"
                                android:layout_height="45dp"

                                android:src="@drawable/ccount2"

                                app:layout_constraintLeft_toLeftOf="parent"
                                app:layout_constraintRight_toLeftOf="@id/textComment1"

                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"/>

                            <androidx.cardview.widget.CardView
                                android:layout_width="330dp"
                                android:layout_height="150dp"

                                app:cardCornerRadius="30dp"
                                app:cardBackgroundColor="#80000000"
                                app:layout_constraintLeft_toRightOf="@id/imgComment1"
                                app:layout_constraintRight_toRightOf="parent"

                                app:layout_constraintTop_toTopOf="@id/imgComment1"
                                app:layout_constraintBottom_toBottomOf="@id/imgComment1"
                                >

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="#754C3A47"/>

                            </androidx.cardview.widget.CardView>
                            
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/conatinerComment2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="20dp"
                            app:layout_constraintTop_toBottomOf="@id/conatinerComment1">

                            <ImageView
                                android:layout_width="45dp"
                                android:layout_height="45dp"

                                android:src="@drawable/ccount2"

                                app:layout_constraintLeft_toLeftOf="parent"
                                app:layout_constraintRight_toLeftOf="@id/textComment1"

                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"/>

                            <androidx.cardview.widget.CardView
                                android:layout_width="330dp"
                                android:layout_height="150dp"


                                app:cardCornerRadius="30dp"
                                app:cardBackgroundColor="#80000000"
                                app:layout_constraintLeft_toRightOf="@id/imgComment1"
                                app:layout_constraintRight_toRightOf="parent"

                                app:layout_constraintTop_toTopOf="@id/imgComment1"
                                app:layout_constraintBottom_toBottomOf="@id/imgComment1"
                                >

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"/>

                            </androidx.cardview.widget.CardView>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/conatinerComment3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="20dp"
                            app:layout_constraintTop_toBottomOf="@id/conatinerComment2">

                            <ImageView
                                android:id="@+id/imgComment1"
                                android:layout_width="45dp"
                                android:layout_height="45dp"

                                android:src="@drawable/ccount2"

                                app:layout_constraintLeft_toLeftOf="parent"
                                app:layout_constraintRight_toLeftOf="@id/textComment1"

                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"/>

                            <androidx.cardview.widget.CardView
                                android:id="@+id/textComment1"
                                android:layout_width="330dp"
                                android:layout_height="150dp"


                                app:cardCornerRadius="30dp"
                                app:cardBackgroundColor="#80000000"
                                app:layout_constraintLeft_toRightOf="@id/imgComment1"
                                app:layout_constraintRight_toRightOf="parent"

                                app:layout_constraintTop_toTopOf="@id/imgComment1"
                                app:layout_constraintBottom_toBottomOf="@id/imgComment1"
                                >
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="#4DB18484"/>

                            </androidx.cardview.widget.CardView>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/conatinerComment4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginBottom="10dp"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <ImageView
                                android:layout_width="35dp"
                                android:layout_height="35dp"

                                android:src="@drawable/ccount2"

                                app:layout_constraintLeft_toLeftOf="parent"
                                app:layout_constraintRight_toLeftOf="@id/textComment1"

                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"/>

                            <androidx.cardview.widget.CardView
                                android:layout_width="330dp"
                                android:layout_height="40dp"


                                app:cardCornerRadius="30dp"
                                app:cardBackgroundColor="#00FFFFFF"
                                app:layout_constraintLeft_toRightOf="@id/imgComment1"
                                app:layout_constraintRight_toRightOf="parent"

                                app:layout_constraintTop_toTopOf="@id/imgComment1"
                                app:layout_constraintBottom_toBottomOf="@id/imgComment1"
                                >
                                <EditText
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"

                                    android:text="Entrer votre commentaire ici"
                                    android:textColor="#D0000000"
                                    android:textStyle="bold"

                                    android:paddingLeft="15dp"
                                    android:background="#B2FFFFFF"/>

                            </androidx.cardview.widget.CardView>

                        </LinearLayout>


                    </androidx.constraintlayout.widget.ConstraintLayout>







                </androidx.cardview.widget.CardView>


            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/autreCité"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"


                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardimgchambre">


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cardAutreCité1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    app:cardCornerRadius="20dp"

                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toLeftOf="@id/cardAutreCité3"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/autreCité1"
                        android:layout_width="23dp"
                        android:layout_height="23dp"

                        android:scaleType="centerCrop"
                        android:src="@drawable/pps"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                    </ImageView>

                </androidx.constraintlayout.widget.ConstraintLayout>


                <androidx.cardview.widget.CardView

                    android:id="@+id/cardAutreCité3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    app:cardCornerRadius="18dp"


                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/cardAutreCité1"
                    app:layout_constraintRight_toLeftOf="@id/cardAutreCité4"
                    app:layout_constraintTop_toTopOf="parent">


                    <ImageView
                        android:layout_width="23dp"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/prix"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                    </ImageView>


                </androidx.cardview.widget.CardView>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cardAutreCité4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:background="@drawable/round3"
                    android:padding="10dp"

                    app:cardCornerRadius="18dp"

                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/cardAutreCité3"
                    app:layout_constraintRight_toLeftOf="@id/cardAutreCité5"
                    app:layout_constraintTop_toTopOf="parent">


                    <ImageView

                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/photo"
                        app:layout_constraintBottom_toBottomOf="parent">

                    </ImageView>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cardAutreCité5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    app:cardCornerRadius="18dp"


                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/cardAutreCité4"
                    app:layout_constraintRight_toLeftOf="@id/cardAutreCité6"
                    app:layout_constraintTop_toTopOf="parent">


                    <ImageView

                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/comment"
                        app:layout_constraintBottom_toBottomOf="parent">

                    </ImageView>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cardAutreCité6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    app:cardCornerRadius="18dp"


                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/cardAutreCité5"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent">


                    <ImageView

                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/plce"
                        app:layout_constraintBottom_toBottomOf="parent">

                    </ImageView>

                </androidx.constraintlayout.widget.ConstraintLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>