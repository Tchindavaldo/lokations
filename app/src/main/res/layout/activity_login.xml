<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".login"
    >

<ImageView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:src="@drawable/mblur3"
    android:scaleType="centerCrop"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"


        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>


    <LinearLayout
        android:id="@+id/conatiner_login"
        android:layout_width="match_parent"
            android:layout_height="0dp"
        app:layout_constraintHeight_percent="1"
            android:gravity="left"
            android:orientation="vertical"

        android:layout_marginLeft="25dp"
        android:layout_marginRight="25dp"

        app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.30"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:gravity="left">

                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"



                    android:text="Bienvenue sur \nLokations "
                    android:textColor="@color/white"
                    android:textSize="30sp"
                    android:textStyle="bold" />
                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"


                    android:layout_marginTop="15dp"

                    android:text="Trouver la maison la chambre l'appartement le studio ou l'hotel qui vous convient"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp" />


            </LinearLayout>


        </LinearLayout>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:orientation="vertical">

    <TextView

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"


        android:layout_marginTop="0dp"
        android:text="Connecter vous pour continuer"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="5dp"/>

    <LinearLayout
        android:id="@+id/input_email"
        android:layout_width="match_parent"
        android:layout_height="45dp"

        app:cardCornerRadius="25dp"
        android:background="@drawable/round_black_25_15"
        app:cardBackgroundColor="#7AFFFFFF">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.2"
            android:gravity="center">
            <ImageView
                android:layout_width="14dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_baseline_person_outline_24"/>
        </LinearLayout>
        <EditText
            android:id="@+id/email"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="Email"
            android:backgroundTint="#00FFFFFF"
            android:textColor="@color/white_50"
            android:textSize="15sp"

            android:textStyle="bold"/>
    </LinearLayout>


    <LinearLayout
        android:id="@+id/input_login"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        app:cardCornerRadius="25dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/round_black_25_15">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.2"
            android:gravity="center">
            <ImageView
                android:layout_width="14dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_baseline_lock_24"/>
        </LinearLayout>
        <EditText
            android:id="@+id/password"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"

            android:text=".........."
            android:textColor="@color/white_50"
            android:textSize="25sp"
            android:textStyle="bold"
            android:backgroundTint="#00000000"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.2"
            android:gravity="center">
            <ImageView
                android:layout_width="14dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_baseline_visibility_24"/>
        </LinearLayout>

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"


        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"


                android:text="se souvenoir la prochaine fois"
                android:textColor="@color/white_50"
                android:textSize="11sp"

                app:layout_constraintTop_toTopOf="parent" />



        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="right"
            android:layout_weight="1">
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                />
        </LinearLayout>



    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="35dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/connexion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="25dp"

            app:cardBackgroundColor="#00FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/conatiner_login"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent" >
            <TextView

                android:layout_width="match_parent"
                android:layout_height="50dp"

                android:padding="10dp"
                android:gravity="center"
                android:layout_gravity="center"

                android:background="@color/black"
                android:text="connnexion"
                android:textColor="@color/white"
                android:textSize="15sp"

                android:textStyle="bold" />


        </androidx.cardview.widget.CardView>

        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"


            android:layout_marginTop="5dp"
            android:text="mot de pase oublié? "
            android:textColor="@color/white_50"

            android:textSize="15sp"

            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent" />

    </LinearLayout>

</LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.3"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="25dp"
                android:layout_weight="0.5"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/white_50"
                    android:layout_marginRight="5dp"
                    android:gravity="center" />

                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"


                    android:text="ou "
                    android:textColor="@color/white"
                    android:textSize="16sp"


                    android:textStyle="bold"

                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/white_50"
                    android:layout_marginLeft="5dp"
                    android:gravity="center" />


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"

                android:layout_weight="0.3"
                android:gravity="center"
                android:orientation="vertical">

                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"


                    android:text="connexion via resau social "
                    android:textColor="@color/white_50"
                    android:textSize="15sp"


                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.3"
                android:gravity="center">


                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"

                    android:src="@drawable/logo_google" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginLeft="25dp"
                    android:layout_marginRight="15dp"
                    android:src="@drawable/logo_facebook" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"

                    android:layout_marginLeft="15dp"
                    android:layout_marginRight="25dp"
                    android:src="@drawable/logo_apple_svg" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/logo_whatsapp_svg" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.3"
                android:gravity="center">

                <TextView
                    android:id="@+id/inscription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"


                    android:text="vous n'avez pas de compte? "
                    android:textColor="@color/white_50"
                    android:textSize="15sp"

                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent" />

                <TextView

                    android:id="@+id/link_to_inscription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"


                    android:text="Inscription "
                    android:textColor="@color/white"
                    android:textSize="16sp"


                    android:textStyle="bold"

                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent" />

            </LinearLayout>

        </LinearLayout>

        </LinearLayout>







</androidx.constraintlayout.widget.ConstraintLayout>