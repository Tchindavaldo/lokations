<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="#F9F2FC"

    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout

        android:id="@+id/L"
        android:layout_width="165dp"
        android:layout_height="match_parent"


        android:paddingLeft="7dp"
        android:paddingRight="7dp"

        android:paddingBottom="30dp">

        <androidx.constraintlayout.widget.ConstraintLayout

            android:id="@+id/L4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent">

            <TextView
                android:id="@+id/textView4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="4dp"
                android:text="fv  lv  ds"
                android:textColor="@color/black_70"
                android:textSize="9dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imgcrd" />

            <androidx.cardview.widget.CardView
                android:id="@+id/imgcrd"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                app:cardCornerRadius="13dp">

                <ImageView
                    android:id="@+id/imghome4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/m91"
                    app:layout_constraintTop_toTopOf="parent">

                </ImageView>


            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/textView44"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentBottom="true"
                android:layout_marginTop="4dp"
                android:text="cité hypocrate"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:textStyle="bold"

                app:layout_constraintTop_toBottomOf="@+id/imgcrd" />

            <TextView
                android:id="@+id/textView3C"
                style="@android:style/Widget.Material.TextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="24 chambre"
                android:textColor="@color/black_70"
                android:textSize="8dp"
                app:layout_constraintTop_toBottomOf="@id/textView44" />


            <TextView
                android:id="@+id/textView3Cl"
                style="@android:style/Widget.Material.TextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20 chambre libre"
                android:textColor="@color/black_70"

                android:textSize="8dp"
                app:layout_constraintTop_toBottomOf="@+id/textView3C" />

            <TextView
                android:id="@+id/textView3Clb"
                style="@android:style/Widget.Material.TextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4 en cours de l'iberation"
                android:textColor="@color/black_70"

                android:textSize="8dp"
                app:layout_constraintTop_toBottomOf="@+id/textView3Cl" />

            <TextView
                android:id="@+id/textViewqv3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="fv  lv"
                android:textColor="@color/black_70"
                android:textSize="9dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>